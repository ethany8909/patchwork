{
  "name": "Patchwork: eczema & psoriasis journal",
  "short_name": "Patchwork",
  "description": "A private, all-in-one eczema app built for every skin tone: check-ins without redness, skin weather, product label checks and a one-page report for your dermatologist.",
  "id": "/",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f3ee",
  "theme_color": "#f6f3ee",
  "categories": ["health", "medical", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Check in", "url": "/#/checkin", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Visit report", "url": "/#/visit", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
